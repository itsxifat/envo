[Unit]
Description=Envo PBX dashboard and API
Wants=network-online.target
After=network-online.target postgresql.service asterisk.service

[Service]
Type=simple
User=envo
Group=envo
SupplementaryGroups=asterisk
UMask=0002
EnvironmentFile=/etc/envo/envo.env
WorkingDirectory=/opt/envo/current/server
ExecStart=/opt/envo/node/bin/node --enable-source-maps index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/etc/asterisk/envo

[Install]
WantedBy=multi-user.target
